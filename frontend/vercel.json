{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "tsc --noEmit && vite build --outDir dist",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "patchpilot-lac.vercel.app" }],
      "destination": "https://tech.runs-on.dev/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://paint-filme-finished-expanding.trycloudflare.com/api/:path*" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}

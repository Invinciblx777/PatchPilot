{
  "name": "patchpilot-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PatchPilot web UI (served by patchpilot-ui)",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/shantell-sans": "^5.3.0",
    "@fontsource/commit-mono": "^5.3.0",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}

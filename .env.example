# AgntID runtime MCP address. The documented local default is shown.
AGNTID_MCP_URL=http://localhost:8082/mcp

# Raw OAuth access token, only if Runtime Security requires client auth.
# No "Bearer " prefix. Never commit a real value.
AGNTID_ACCESS_TOKEN=

# Optional bound (seconds) on connect + tools/list + close, and on each
# task-session tools/list and task-open step. Default: 20.
AGNTID_TIMEOUT_SECONDS=

# Module 2 task identity: PatchPilot application settings, not AgntID-standard
# names. Set from trusted deployment configuration, never from prompt text.
# Stable opaque IDs only: letters, digits, . _ : - (no email addresses).
PATCHPILOT_AGENT_ID=patchpilot:v1
PATCHPILOT_USER_ID=

# Module 3: path to a human-reviewed capability map (see README). Unset means
# the GitHub integration stays disabled. PatchPilot never holds a GitHub token.
PATCHPILOT_CAPABILITY_MAP=
